---
import Bange from "@/components/base/Bange.astro";
import Button from "@/components/base/Button.astro";
---

<section class="feedback section-offset">
  <div class="container">
    <Bange class="feedback__bange">+82 счастливых пользователя в этом году</Bange>
    <div class="feedback__inner">
      <h2 class="feedback__title title">Остался всего один шаг</h2>
      <div class="feedback__action">
        <Button class="feedback__btn" variant="primary" size="sm">Получить консультацию</Button>
        <Button href="/contacts" class="feedback__btn" variant="secondary" size="sm">В контакты</Button>
      </div>
    </div>
    <p class="feedback__descr main-descr">Осталось только связаться с нами и мы выполним монтаж автономной канализации всего за 1 день</p>
  </div>
</section>
