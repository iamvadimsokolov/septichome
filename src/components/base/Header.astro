---
import Logo from "@/components/base/Logo.astro";
import Nav from "@/components/base/Nav.astro";
import Action from "@/components/base/HeaderAction.astro";
import { menu } from "@/data/data";
---

<header class="header fixed-block" data-header>
  <div class="container">
    <div class="header__inner">
      <Logo class="header__logo" />
      <Nav class="header__nav" menu={menu} id="main-menu"/>
      <Action class="header__action" />
    </div>
  </div>
</header>
