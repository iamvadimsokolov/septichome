---
const { class: className = "" } = Astro.props;
const isHome = Astro.url.pathname === "/";
import { metadata } from "@/data/data";

const siteTitleRu = metadata.find(
  (item) => item.label === "site_title_ru",
)?.href;
---

<div class=`logo ${className}`>
  {
    isHome ? (
      <span class="logo__title">{siteTitleRu}</span>
    ) : (
      <a class="logo__title" href="/">
        {siteTitleRu}
      </a>
    )
  }
  <span class="logo__descr"
    >Монтаж автономной канализации в Москве и Московской области</span
  >
</div>
