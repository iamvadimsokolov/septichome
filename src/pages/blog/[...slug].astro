---
import Layout from "@/layouts/Layout.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Bange from "@/components/base/Bange.astro";
import { Image } from "astro:assets";

type Props = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const h2Headings = headings.filter((heading) => heading.depth === 2);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  date={post.data.pubDate}
>
  <section class="post section-offset">
    <div class="container">
      <div class="post__inner">
        <Bange class="post__bange"
          >Опубликовано · <time datetime={post.data.pubDate.toISOString()}
            >{formattedDate}</time
          ></Bange
        >
        <h1 class="post__title title">{post.data.title}</h1>
        <p class="post__descr main-descr">{post.data.description}</p>
        {
          post.data.image && (
            <Image
              src={post.data.image}
              width={1200}
              height={500}
              alt=""
              aria-hidden="true"
              class="post__bg"
            />
          )
        }
      </div>
      <div class="post__content post-content grid">
        <div class="post-content__text">
          <Content />
        </div>
        <aside class="post-content__headlines headlines">
          <nav class="headlines__nav" aria-label="Оглавление статьи">
            <h2 class="headlines__title">На этой странице</h2>
            <ul class="headlines__list list-reset">
              {
                h2Headings.map((heading) => (
                  <li class="headlines__item">
                    <a
                      href={`#${heading.slug}`}
                      class="headlines__link"
                      data-headlines-link
                    >
                      {heading.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </aside>
      </div>
      <div class="post-content__test"></div>
    </div>
  </section>
</Layout>
