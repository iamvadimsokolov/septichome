---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/partials/blog/HeroBlog.astro";
import PostList from "@/components/partials/blog/PostList.astro";
import { getCollection, type CollectionEntry } from "astro:content";

// Получение всех постов
const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

// Сортировка по дате
const posts = allPosts
  .filter((post) => post.data.pubDate)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Блог о септиках"
  description="Всё, что нужно знать о септиках и автономных станциях биологической очистки">
  <Hero />
  <PostList />
</Layout>
